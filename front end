<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CropStore - Ghanaian Staple Crops</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #2e7d32;
            --primary-dark: #1b5e20;
            --primary-light: #e8f5e9;
            --secondary: #f57c00;
            --danger: #dc3545;
            --success: #28a745;
            --organic: #2e7d32;
            --seasonal: #f57c00;
            --bulk: #0d47a1;
            --gold: #ffd700;
            --gray-100: #f8f9fa;
            --gray-200: #e9ecef;
            --gray-300: #dee2e6;
            --gray-400: #ced4da;
            --gray-500: #adb5bd;
            --gray-600: #6c757d;
            --gray-700: #495057;
            --gray-800: #343a40;
            --gray-900: #212529;
            --shadow: 0 2px 10px rgba(3, 0, 0, 0.1);
            --shadow-hover: 0 4px 20px rgba(0,0,0,0.15);
            --radius: 12px;
            --transition: all 0.3s ease;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--gray-100);
            color: var(--gray-900);
            padding-top: 70px;
            min-height: 100vh;
        }
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: white;
            box-shadow: var(--shadow);
            padding: 12px 0;
            z-index: 1000;
        }
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }
        .nav-logo {
            font-size: 24px;
            font-weight: 800;
            color: var(--primary);
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
        }
        .nav-logo i { margin-right: 8px; }
        .nav-search {
            flex: 1;
            max-width: 500px;
            display: flex;
            background: var(--gray-100);
            border-radius: 50px;
            overflow: hidden;
        }
        .nav-search input {
            flex: 1;
            border: none;
            padding: 10px 20px;
            background: transparent;
            font-size: 14px;
            outline: none;
        }
        .nav-search button {
            border: none;
            background: transparent;
            padding: 10px 20px;
            color: var(--gray-600);
            cursor: pointer;
        }
        .nav-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }
        .nav-actions button {
            background: none;
            border: none;
            font-size: 20px;
            color: var(--gray-700);
            cursor: pointer;
            position: relative;
            padding: 8px;
            border-radius: 50%;
            transition: var(--transition);
        }
        .nav-actions button:hover { background: var(--gray-100); }
        .cart-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--danger);
            color: white;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 50%;
            min-width: 20px;
            text-align: center;
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        
        /* Hero Banner */
        .hero-banner {
            background: linear-gradient(135deg, #1b5e20, #2e7d32, #388e3c);
            border-radius: var(--radius);
            padding: 40px;
            color: white;
            margin-bottom: 30px;
            position: relative;
            overflow: hidden;
        }
        .hero-banner::before {
            content: '🌾';
            position: absolute;
            right: 40px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 120px;
            opacity: 0.15;
        }
        .hero-banner h1 { font-size: 32px; margin-bottom: 8px; }
        .hero-banner p { opacity: 0.9; font-size: 16px; }
        .hero-banner .badge-group {
            display: flex;
            gap: 12px;
            margin-top: 16px;
            flex-wrap: wrap;
        }
        .hero-banner .badge {
            background: rgba(255,255,255,0.15);
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 8px;
            backdrop-filter: blur(5px);
        }
        
        /* Quick Crop Links */
        .quick-crops {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
            margin-bottom: 30px;
        }
        .quick-crop {
            background: white;
            padding: 16px;
            text-align: center;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            cursor: pointer;
            transition: var(--transition);
            border: 2px solid transparent;
        }
        .quick-crop:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
        .quick-crop.active { border-color: var(--primary); }
        .quick-crop .crop-icon { font-size: 32px; display: block; margin-bottom: 8px; }
        .quick-crop .crop-name { font-weight: 600; font-size: 14px; }
        .quick-crop .crop-season { font-size: 11px; color: var(--gray-600); }
        
        /* Filter Bar */
        .filter-bar {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
            background: white;
            padding: 16px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            align-items: center;
        }
        .filter-bar select, .filter-bar input {
            padding: 8px 16px;
            border: 1px solid var(--gray-300);
            border-radius: 8px;
            font-size: 14px;
            background: white;
        }
        .filter-bar .filter-btn {
            padding: 8px 20px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }
        .filter-bar .filter-btn:hover { background: var(--primary-dark); }
        .filter-bar .filter-btn.active { background: var(--secondary); }
        
        /* Products */
        .products-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 12px;
        }
        .products-header h2 { font-size: 20px; }
        .products-controls select {
            padding: 8px 16px;
            border: 1px solid var(--gray-300);
            border-radius: 8px;
            background: white;
            font-size: 14px;
            cursor: pointer;
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
        .product-card {
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition);
            position: relative;
        }
        .product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
        
        .product-card .badges {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .product-card .badge-tag {
            padding: 3px 10px;
            border-radius: 50px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .badge-organic { background: var(--organic); color: white; }
        .badge-seasonal { background: var(--seasonal); color: white; }
        .badge-bulk { background: var(--bulk); color: white; }
        .badge-premium { background: var(--gold); color: #1b5e20; }
        
        .product-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            background: var(--gray-200);
        }
        .product-card .product-info { padding: 16px; }
        .product-card h3 { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
        .product-card .variety { font-size: 13px; color: var(--gray-600); margin-bottom: 4px; }
        .product-card .region { font-size: 12px; color: var(--gray-500); margin-bottom: 4px; }
        .product-card .price { font-size: 20px; font-weight: 700; color: var(--primary); margin: 8px 0; }
        .product-card .price .original { 
            font-size: 14px; 
            color: var(--gray-500);
            text-decoration: line-through;
            margin-left: 8px;
            font-weight: 400;
        }
        .product-card .stock { font-size: 13px; color: var(--gray-600); margin-bottom: 4px; }
        .product-card .stock.low { color: var(--danger); }
        .product-card .grade {
            font-size: 12px;
            background: var(--gold);
            color: #1b5e20;
            padding: 2px 10px;
            border-radius: 50px;
            display: inline-block;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .product-card .season-status {
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 4px;
            margin-bottom: 8px;
        }
        .product-card .season-status .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }
        .product-card .season-status .status-dot.in-season { background: var(--success); }
        .product-card .season-status .status-dot.off-season { background: var(--gray-400); }
        
        .product-card .bulk-option {
            font-size: 12px;
            color: var(--gray-600);
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .product-card .bulk-option i { color: var(--bulk); }
        .product-card .bulk-discount {
            font-size: 12px;
            color: var(--success);
            font-weight: 700;
        }
        
        .product-card .add-to-cart {
            width: 100%;
            padding: 10px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }
        .product-card .add-to-cart:hover { background: var(--primary-dark); }
        .product-card .add-to-cart:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .product-card .bulk-btn {
            width: 100%;
            padding: 8px;
            background: var(--bulk);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 4px;
            font-size: 13px;
        }
        .product-card .bulk-btn:hover { opacity: 0.9; }
        
        .load-more-container { text-align: center; margin-top: 30px; }
        #loadMoreBtn {
            padding: 12px 40px;
            background: white;
            border: 2px solid var(--gray-300);
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }
        #loadMoreBtn:hover { border-color: var(--primary); color: var(--primary); }
        
        /* Cart */
        .cart-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 2000;
            display: none;
        }
        .cart-overlay.active { display: block; }
        .cart-sidebar {
            position: fixed;
            top: 0;
            right: -420px;
            width: 100%;
            max-width: 400px;
            height: 100%;
            background: white;
            z-index: 2001;
            transition: right 0.3s ease;
            display: flex;
            flex-direction: column;
        }
        .cart-sidebar.active { right: 0; }
        .cart-header {
            padding: 20px;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .cart-header h3 { font-size: 18px; }
        .close-btn {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
            color: var(--gray-600);
            padding: 4px 8px;
        }
        .cart-items { flex: 1; overflow-y: auto; padding: 20px; }
        .cart-item {
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--gray-100);
        }
        .cart-item img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            background: var(--gray-200);
        }
        .cart-item .item-info { flex: 1; }
        .cart-item .item-name { font-weight: 600; font-size: 14px; }
        .cart-item .item-price { color: var(--primary); font-weight: 600; }
        .cart-item .item-controls {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 4px;
        }
        .cart-item .item-controls button {
            background: var(--gray-200);
            border: none;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            font-weight: 700;
            cursor: pointer;
        }
        .cart-item .item-controls span { font-weight: 600; min-width: 24px; text-align: center; }
        .cart-footer {
            padding: 20px;
            border-top: 1px solid var(--gray-200);
        }
        .cart-total {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 12px;
        }
        .checkout-btn {
            width: 100%;
            padding: 14px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            transition: var(--transition);
        }
        .checkout-btn:hover { background: var(--primary-dark); }
        
        /* Modal */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .modal.active { display: flex; }
        .modal-content {
            background: white;
            border-radius: var(--radius);
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 30px;
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 14px; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--gray-300);
            border-radius: 8px;
            font-size: 14px;
            transition: var(--transition);
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(46,125,50,0.1);
        }
        .btn-primary {
            padding: 12px 24px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
        }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-full { width: 100%; }
        .order-summary {
            background: var(--gray-100);
            padding: 16px;
            border-radius: 8px;
            margin: 16px 0;
        }
        .order-summary-item {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
        }
        .order-summary-total {
            display: flex;
            justify-content: space-between;
            font-weight: 700;
            font-size: 18px;
            padding-top: 8px;
            border-top: 2px solid var(--gray-300);
            margin-top: 8px;
        }
        
        /* Chatbot */
        .chatbot-widget {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 4000;
        }
        .chatbot-toggle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            border: none;
            font-size: 28px;
            box-shadow: var(--shadow-hover);
            cursor: pointer;
            transition: var(--transition);
        }
        .chatbot-toggle:hover { transform: scale(1.05); }
        .chatbot-container {
            position: absolute;
            bottom: 80px;
            right: 0;
            width: 350px;
            max-width: 90vw;
            height: 450px;
            background: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow-hover);
            display: none;
            flex-direction: column;
            overflow: hidden;
        }
        .chatbot-container.active { display: flex; }
        .chatbot-header {
            padding: 12px 16px;
            background: var(--primary);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .chatbot-header .close-btn { color: white; }
        .chat-messages { flex: 1; overflow-y: auto; padding: 16px; }
        .message { margin-bottom: 12px; display: flex; }
        .message.bot { justify-content: flex-start; }
        .message.user { justify-content: flex-end; }
        .message-content {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.5;
            white-space: pre-line;
        }
        .message.bot .message-content { background: var(--gray-200); color: var(--gray-800); }
        .message.user .message-content { background: var(--primary); color: white; }
        .chat-input {
            display: flex;
            padding: 12px;
            border-top: 1px solid var(--gray-200);
            gap: 8px;
        }
        .chat-input input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid var(--gray-300);
            border-radius: 50px;
            outline: none;
        }
        .chat-input button {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            border: none;
            cursor: pointer;
        }
        
        .toast {
            position: fixed;
            top: 80px;
            right: 20px;
            padding: 16px 24px;
            border-radius: var(--radius);
            background: white;
            box-shadow: var(--shadow-hover);
            z-index: 5000;
            max-width: 400px;
            animation: slideIn 0.3s ease;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .toast.success { border-left: 4px solid var(--success); }
        .toast.error { border-left: 4px solid var(--danger); }
        .toast.warning { border-left: 4px solid var(--secondary); }
        .toast.info { border-left: 4px solid var(--primary); }
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        .empty-state { text-align: center; padding: 60px 20px; grid-column: 1/-1; }
        .empty-state i { font-size: 48px; color: var(--gray-400); }
        .empty-state h3 { margin-top: 16px; }
        .empty-state p { color: var(--gray-600); }
        
        @media (max-width: 768px) {
            body { padding-top: 60px; }
            .nav-search { display: none; }
            .product-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
            .cart-sidebar { max-width: 100%; }
            .modal-content { padding: 20px; margin: 16px; }
            .hero-banner { padding: 24px; }
            .hero-banner h1 { font-size: 24px; }
            .hero-banner::before { font-size: 60px; right: 20px; }
            .filter-bar { padding: 12px; flex-direction: column; }
            .filter-bar select, .filter-bar input { width: 100%; }
            .quick-crops { grid-template-columns: repeat(3, 1fr); }
            .quick-crop { padding: 12px; }
            .quick-crop .crop-icon { font-size: 24px; }
            .chatbot-container { width: 100%; height: 400px; bottom: 80px; right: 0; }
        }
        @media (max-width: 480px) {
            .product-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
            .product-card .product-info { padding: 12px; }
            .product-card h3 { font-size: 13px; }
            .product-card .price { font-size: 16px; }
            .quick-crops { grid-template-columns: repeat(3, 1fr); gap: 8px; }
            .quick-crop .crop-name { font-size: 12px; }
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="nav-container">
        <a class="nav-logo" href="/"><i class="fas fa-seedling"></i> CropStore</a>
        <div class="nav-search">
            <input type="text" id="searchInput" placeholder="Search cassava, maize, yam, rice..." oninput="handleSearch()">
            <button onclick="handleSearch()"><i class="fas fa-search"></i></button>
        </div>
        <div class="nav-actions">
            <button onclick="toggleChatbot()"><i class="fas fa-comment-dots"></i></button>
            <button onclick="toggleCart()">
                <i class="fas fa-shopping-cart"></i>
                <span id="cartCount" class="cart-badge">0</span>
            </button>
            <button id="authBtn" onclick="handleAuth()"><i class="fas fa-user"></i></button>
        </div>
    </div>
</nav>

<main class="container">
    <!-- Hero Banner -->
    <div class="hero-banner">
        <div>
            <h1>🌾 Ghanaian Staple Crops</h1>
            <p>Fresh cassava, maize, potatoes, yam, rice, and wheat from local farms</p>
            <div class="badge-group">
                <span class="badge"><i class="fas fa-leaf"></i> Organic Available</span>
                <span class="badge"><i class="fas fa-calendar-alt"></i> In Season</span>
                <span class="badge"><i class="fas fa-box"></i> Bulk Pricing</span>
                <span class="badge"><i class="fas fa-trophy"></i> Premium Quality</span>
            </div>
        </div>
    </div>

    <!-- Quick Crop Navigation -->
    <div class="quick-crops" id="quickCrops">
        <div class="quick-crop active" data-crop="all" onclick="filterByCrop('all')">
            <span class="crop-icon">🌾</span>
            <span class="crop-name">All Crops</span>
        </div>
        <div class="quick-crop" data-crop="cassava" onclick="filterByCrop('cassava')">
            <span class="crop-icon">🌱</span>
            <span class="crop-name">Cassava</span>
            <span class="crop-season">Year-round</span>
        </div>
        <div class="quick-crop" data-crop="maize" onclick="filterByCrop('maize')">
            <span class="crop-icon">🌽</span>
            <span class="crop-name">Maize</span>
            <span class="crop-season">Mar-Jun, Sep-Nov</span>
        </div>
        <div class="quick-crop" data-crop="potatoes" onclick="filterByCrop('potatoes')">
            <span class="crop-icon">🥔</span>
            <span class="crop-name">Potatoes</span>
            <span class="crop-season">Oct-Dec</span>
        </div>
