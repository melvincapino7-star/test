<script>
// ==================== STATE MANAGEMENT ====================
const AppState = {
    user: null,
    cart: [],
    products: [],
    categories: [],
    cartTotal: 0,
    cartCount: 0,
    currentPage: 1,
    hasMore: true,
    isLoading: false,
    isAuthLogin: true,

    loadFromStorage() {
        try {
            const saved = localStorage.getItem('app_state');
            if (saved) {
                const parsed = JSON.parse(saved);
                Object.assign(this, parsed);
            }
        } catch(e) {}
    },

    saveToStorage() {
        try {
            localStorage.setItem('app_state', JSON.stringify({
                user: this.user,
                cart: this.cart,
                cartTotal: this.cartTotal,
                cartCount: this.cartCount
            }));
        } catch(e) {}
    },

    setUser(user) {
        this.user = user;
        this.saveToStorage();
        this.updateUI();
    },

    setCart(cart) {
        this.cart = cart;
        this.cartTotal = cart.reduce((sum, i) => sum + (i.effective_price || i.price_per_kg) * i.quantity_kg, 0);
        this.cartCount = cart.reduce((sum, i) => sum + i.quantity_kg, 0);
        this.saveToStorage();
        this.updateUI();
    },

    updateUI() {
        document.getElementById('cartCount').textContent = this.cartCount;
        document.getElementById('cartTotal').textContent = `₵${this.cartTotal.toFixed(2)}`;
        this.renderCart();
        this.renderAuthButton();
    },

    renderAuthButton() {
        const btn = document.getElementById('authBtn');
        if (this.user) {
            btn.innerHTML = `<i class="fas fa-user-check"></i>`;
            btn.title = this.user.full_name;
        } else {
            btn.innerHTML = `<i class="fas fa-user"></i>`;
            btn.title = 'Login';
        }
    },

    renderCart() {
        const container = document.getElementById('cartItems');
        if (this.cart.length === 0) {
            container.innerHTML = `<div class="empty-cart" style="text-align:center;padding:40px 20px;">
                <i class="fas fa-shopping-cart" style="font-size:48px;color:var(--gray-400);"></i>
                <p style="color:var(--gray-600);margin-top:12px;">Your cart is empty</p>
            </div>`;
            return;
        }
        container.innerHTML = this.cart.map(item => {
            const price = item.effective_price || item.price_per_kg;
            return `
            <div class="cart-item">
                <img src="${item.image_url || '/placeholder.jpg'}" alt="${item.name}" onerror="this.src='/placeholder.jpg'">
                <div class="item-info">
                    <div class="item-name">${item.name}</div>
                    <div class="item-price">₵${Number(price).toFixed(2)}/kg</div>
                    ${item.is_bulk ? '<div style="font-size:11px;color:var(--bulk);font-weight:600;">📦 Bulk Order</div>' : ''}
                    <div class="item-controls">
                        <button onclick="updateCartItem(${item.product_id}, ${item.quantity_kg - 1})">-</button>
                        <span>${item.quantity_kg}kg</span>
                        <button onclick="updateCartItem(${item.product_id}, ${item.quantity_kg + 1})">+</button>
                        <button onclick="updateCartItem(${item.product_id}, 0)" style="margin-left:8px;background:var(--danger);color:white;width:auto;padding:2px 8px;border-radius:4px;font-size:12px;">Remove</button>
                    </div>
                </div>
            </div>
        `}).join('');
    }
};

AppState.loadFromStorage();

// ==================== API HELPERS ====================
function getToken() { return localStorage.getItem('token'); }

async function apiCall(url, options = {}) {
    const headers = { 'Content-Type': 'application/json', ...options.headers };
    const token = getToken();
    if (token) headers['Authorization'] = `Bearer ${token}`;
    
    try {
        const response = await fetch(url, { ...options, headers });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Request failed');
        return data;
    } catch (e) {
        showToast(e.message, 'error');
        throw e;
    }
}

function showToast(message, type = 'info') {
    const existing = document.querySelector('.toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    const icons = { success: 'fa-check-circle', error: 'fa-exclamation-circle', warning: 'fa-exclamation-triangle', info: 'fa-info-circle' };
    toast.innerHTML = `<i class="fas ${icons[type] || icons.info}"></i><span>${message}</span>`;
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateX(100%)'; setTimeout(() => toast.remove(), 300); }, 4000);
}

// ==================== PRODUCTS ====================
async function loadProducts(page = 1, append = false) {
    if (AppState.isLoading) return;
    AppState.isLoading = true;

    const search = document.getElementById('searchInput').value;
    const category = document.getElementById('categoryFilter').value;
    const filter = document.getElementById('filterOptions').value;
    const minPrice = document.getElementById('minPrice').value;
    const maxPrice = document.getElementById('maxPrice').value;
    const sort = document.getElementById('sortBy').value;
    const [sortBy, order] = sort.split('_');

    const params = new URLSearchParams({ limit: 20, offset: (page-1)*20, sort_by: sortBy, order });
    if (search) params.append('search', search);
    if (category && category !== 'all') params.append('category', category);
    if (minPrice) params.append('min_price', minPrice);
    if (maxPrice) params.append('max_price', maxPrice);
    
    if (filter === 'organic') params.append('is_organic', 'true');
    else if (filter === 'in_season') params.append('in_season', 'true');
    else if (filter === 'bulk') params.append('is_bulk', 'true');
    else if (filter === 'premium') params.append('grade', 'Premium');

    try {
        const data = await apiCall(`/api/products?${params}`);
        AppState.products = append ? [...AppState.products, ...data.products] : data.products;
        AppState.currentPage = page;
        AppState.hasMore = data.pagination && data.pagination.pages > page;
        renderProducts();
    } catch(e) {}
    AppState.isLoading = false;
}

function renderProducts() {
    const grid = document.getElementById('productGrid');
    const products = AppState.products;

    if (products.length === 0) {
        grid.innerHTML = `<div class="empty-state"><i class="fas fa-seedling"></i><h3>No crops found</h3><p>Try adjusting your filters</p></div>`;
        document.getElementById('loadMoreContainer').style.display = 'none';
        return;
    }

    grid.innerHTML = products.map(p => {
        let badges = '';
        if (p.is_organic) badges += `<span class="badge-tag badge-organic">🌿 Organic</span>`;
        if (p.in_season) badges += `<span class="badge-tag badge-seasonal">📅 In Season</span>`;
        if (p.is_bulk) badges += `<span class="badge-tag badge-bulk">📦 Bulk</span>`;
        if (p.grade === 'Premium') badges += `<span class="badge-tag badge-premium">⭐ Premium</span>`;
        
        const price = p.price_per_kg;
        const bulkPrice = p.bulk_price_per_kg;
        const displayPrice = bulkPrice && p.is_bulk ? bulkPrice : price;
        const originalPrice = bulkPrice && p.is_bulk ? price : null;
        const discount = p.bulk_discount ? `${p.bulk_discount}% off` : '';
        
        let seasonText = '';
        if (p.in_season) {
            seasonText = `<div class="season-status"><span class="status-dot in-season"></span> In Season Now!</div>`;
        } else {
            seasonText = `<div class="season-status"><span class="status-dot off-season"></span> Off Season</div>`;
        }
        
        let bulkText = '';
        if (p.is_bulk && p.bulk_min_kg) {
            bulkText = `<div class="bulk-option"><i class="fas fa-box"></i> Bulk: min ${p.bulk_min_kg}kg <span class="bulk-discount">${discount}</span></div>`;
        }

        return `
        <div class="product-card">
            <div class="badges">${badges}</div>
            <img src="${p.image_url || '/placeholder.jpg'}" alt="${p.name}" onerror="this.src='/placeholder.jpg'">
            <div class="product-info">
                <h3>${p.name}</h3>
                ${p.crop_variety ? `<div class="variety">${p.crop_variety}</div>` : ''}
                ${p.growing_region ? `<div class="region"><i class="fas fa-map-marker-alt"></i> ${p.growing_region}</div>` : ''}
                ${p.grade ? `<div class="grade">⭐ ${p.grade}</div>` : ''}
                <div class="price">
                    ₵${Number(displayPrice).toFixed(2)}/kg
                    ${originalPrice ? `<span class="original">₵${Number(originalPrice).toFixed(2)}/kg</span>` : ''}
                </div>
                <div class="stock ${p.stock_kg < 100 ? 'low' : ''}">${p.stock_kg} kg in stock</div>
                ${seasonText}
                ${bulkText}
                <button class="add-to-cart" onclick="addToCart(${p.id})" ${p.stock_kg === 0 ? 'disabled' : ''}>
                    <i class="fas fa-cart-plus"></i> Add ${p.is_bulk ? 'Bulk' : ''} to Cart
                </button>
                ${p.is_bulk ? `<button class="bulk-btn" onclick="addBulkToCart(${p.id})"><i class="fas fa-box"></i> Bulk Order (${p.bulk_min_kg}kg min)</button>` : ''}
            </div>
        </div>
    `}).join('');

    document.getElementById('loadMoreContainer').style.display = AppState.hasMore ? 'block' : 'none';
}

function loadMoreProducts() {
    loadProducts(AppState.currentPage + 1, true);
}

function handleSearch() {
    loadProducts(1);
}

function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('categoryFilter').value = 'all';
    document.getElementById('filterOptions').value = 'all';
    document.getElementById('minPrice').value = '';
    document.getElementById('maxPrice').value = '';
    document.getElementById('sortBy').value = 'created_at_DESC';
    document.querySelectorAll('.quick-crop').forEach(el => el.classList.remove('active'));
    document.querySelector('.quick-crop[data-crop="all"]').classList.add('active');
    loadProducts(1);
}

function filterByCrop(crop) {
    document.querySelectorAll('.quick-crop').forEach(el => {
        el.classList.toggle('active', el.dataset.crop === crop);
    });
    document.getElementById('categoryFilter').value = crop;
    loadProducts(1);
}

// ==================== CART ====================
async function loadCart() {
    try {
        const data = await apiCall('/api/cart');
        AppState.setCart(data.items || []);
    } catch(e) {
        AppState.setCart([]);
    }
}

async function addToCart(productId) {
    try {
        await apiCall('/api/cart/add', { method: 'POST', body: JSON.stringify({ product_id: productId, quantity_kg: 1 }) });
        await loadCart();
        showToast('Added to cart!', 'success');
    } catch(e) {}
}

async function addBulkToCart(productId) {
    const product = AppState.products.find(p => p.id === productId);
    if (!product) return;
    const minKg = product.bulk_min_kg || 50;
    const quantity = prompt(`Enter bulk quantity (min ${minKg}kg):`);
    if (!quantity) return;
    const qty = parseInt(quantity);
    if (qty < minKg) { showToast(`Bulk minimum is ${minKg}kg`, 'warning'); return; }
    try {
        await apiCall('/api/cart/add', { method: 'POST', body: JSON.stringify({ product_id: productId, quantity_kg: qty, is_bulk: true }) });
        await loadCart();
        showToast(`Bulk order added (${qty}kg)!`, 'success');
    } catch(e) {}
}

async function updateCartItem(productId, quantity) {
    try {
        await apiCall('/api/cart/update', { method: 'PUT', body: JSON.stringify({ product_id: productId, quantity_kg: quantity }) });
        await loadCart();
    } catch(e) {}
}

function toggleCart() {
    document.getElementById('cartOverlay').classList.toggle('active');
    document.getElementById('cartSidebar').classList.toggle('active');
}

// ==================== CHECKOUT ====================
function toggleMomoField() {
    const method = document.getElementById('paymentMethod').value;
    document.getElementById('momoField').style.display = ['momo','vodafone','airtel'].includes(method) ? 'block' : 'none';
}

function checkout() {
    if (AppState.cart.length === 0) { showToast('Your cart is empty', 'warning'); return; }
    if (!AppState.user) { showToast('Please login first', 'warning'); openAuthModal(); return; }
    document.getElementById('checkoutModal').classList.add('active');
    updateCheckoutSummary();
}

function closeCheckout() {
    document.getElementById('checkoutModal').classList.remove('active');
}

function updateCheckoutSummary() {
    const subtotal = AppState.cartTotal;
    const shipping = subtotal < 500 ? 50 : 0;
    const tax = subtotal * 0.125;
    const total = subtotal + shipping + tax;
    document.getElementById('checkoutSummary').innerHTML = `
        <div class="order-summary-item"><span>Subtotal</span><span>₵${subtotal.toFixed(2)}</span></div>
        <div class="order-summary-item"><span>Shipping</span><span>₵${shipping.toFixed(2)}</span></div>
        <div class="order-summary-item"><span>Tax (12.5%)</span><span>₵${tax.toFixed(2)}</span></div>
        <div class="order-summary-total"><span>Total</span><span>₵${total.toFixed(2)}</span></div>
    `;
}

async function placeOrder(event) {
    event.preventDefault();
    const address = document.getElementById('shippingAddress').value;
    const paymentMethod = document.getElementById('paymentMethod').value;
    const momoNumber = document.getElementById('momoNumber').value;
    const notes = document.getElementById('orderNotes').value;

    if (!address) { showToast('Please enter shipping address', 'warning'); return; }
    if (['momo','vodafone','airtel'].includes(paymentMethod) && !momoNumber) {
        showToast('Please enter your mobile money number', 'warning'); return;
    }

    try {
        const order = await apiCall('/api/orders', {
            method: 'POST',
            body: JSON.stringify({ shipping_address: address, notes })
        });

        if (['momo','vodafone','airtel'].includes(paymentMethod)) {
            await apiCall('/api/payments/initiate-momo', {
                method: 'POST',
                body: JSON.stringify({ order_id: order.id, phone: momoNumber })
            });
        }

        AppState.setCart([]);
        closeCheckout();
        toggleCart();
        showToast('Crop order placed! 🌾', 'success');
        showToast('Check WhatsApp for confirmation', 'info');
    } catch(e) {}
}

// ==================== AUTH ====================
function openAuthModal() {
    document.getElementById('authModal').classList.add('active');
    document.getElementById('authModalTitle').textContent = 'Login';
    document.getElementById('authSubmitBtn').textContent = 'Login';
    document.getElementById('authToggleLink').textContent = "Don't have an account? Sign up";
    document.getElementById('signupFields').style.display = 'none';
    AppState.isAuthLogin = true;
}

function closeAuthModal() {
    document.getElementById('authModal').classList.remove('active');
}

function toggleAuthMode() {
    AppState.isAuthLogin = !AppState.isAuthLogin;
    if (AppState.isAuthLogin) {
        document.getElementById('authModalTitle').textContent = 'Login';
        document.getElementById('authSubmitBtn').textContent = 'Login';
        document.getElementById('authToggleLink').textContent = "Don't have an account? Sign up";
        document.getElementById('signupFields').style.display = 'none';
    } else {
        document.getElementById('authModalTitle').textContent = 'Sign Up';
        document.getElementById('authSubmitBtn').textContent = 'Create Account';
        document.getElementById('authToggleLink').textContent = 'Already have an account? Login';
        document.getElementById('signupFields').style.display = 'block';
    }
}

async function handleAuthSubmit(event) {
    event.preventDefault();
    const email = document.getElementById('authEmail').value;
    const password = document.getElementById('authPassword').value;

    if (AppState.isAuthLogin) {
        try {
            const data = await apiCall('/api/auth/login', {
                method: 'POST',
                body: JSON.stringify({ email, password })
            });
            localStorage.setItem('token', data.token);
            AppState.setUser(data.user);
            closeAuthModal();
            showToast(`Welcome back, ${data.user.full_name}!`, 'success');
            await loadCart();
        } catch(e) {}
    } else {
        const full_name = document.getElementById('signupName').value;
        const phone = document.getElementById('signupPhone').value;
        const address = document.getElementById('signupAddress').value;
        if (!full_name || !phone) { showToast('Please fill in all fields', 'warning'); return; }
        try {
            await apiCall('/api/auth/signup', {
                method: 'POST',
                body: JSON.stringify({ email, password, full_name, phone, address })
            });
            showToast('Account created! Please login.', 'success');
            toggleAuthMode();
        } catch(e) {}
    }
}

function handleAuth() {
    if (AppState.user) {
        if (confirm('Logout?')) {
            localStorage.removeItem('token');
            AppState.setUser(null);
            AppState.setCart([]);
            showToast('Logged out', 'info');
        }
    } else {
        openAuthModal();
    }
}

// ==================== CHATBOT ====================
function toggleChatbot() {
    document.getElementById('chatbotContainer').classList.toggle('active');
}

async function sendMessage() {
    const input = document.getElementById('chatInput');
    const message = input.value.trim();
    if (!message) return;

    addChatMessage(message, 'user');
    input.value = '';

    try {
        const data = await apiCall('/api/chatbot', {
            method: 'POST',
            body: JSON.stringify({ message })
        });
        addChatMessage(data.response, 'bot');
        if (data.suggestions) {
            data.suggestions.forEach(s => addChatMessage(`👉 ${s}`, 'bot'));
        }
    } catch(e) {
        addChatMessage('Sorry, I had trouble responding. Please try again.', 'bot');
    }
}

function addChatMessage(message, type) {
    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = `message ${type}`;
    div.innerHTML = `<div class="message-content">${message}</div>`;
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

// ==================== INIT ====================
async function init() {
    await loadProducts(1);
    await loadCart();
    
    const token = getToken();
    if (token) {
        try {
            const user = await apiCall('/api/auth/me');
            AppState.setUser(user);
        } catch(e) {
            localStorage.removeItem('token');
        }
    }
    AppState.updateUI();
}

document.addEventListener('DOMContentLoaded', init);
</script>
